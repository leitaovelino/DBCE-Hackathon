rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profiles Collection
    match /users/{userId} {
      // Users can only read their own profile document
      allow read: if isOwner(userId);
      
      // Allow user creation on signup:
      // Prevent privilege escalation - cannot self-assign 'authority' role
      allow create: if isOwner(userId) 
                    && (!('role' in request.resource.data) || request.resource.data.role in ['tourist', 'business_owner']);
      
      // Allow profile update (e.g. displayName, phone, bio) but prevent role modification
      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role;
      
      // Allow user to delete their account profile
      allow delete: if isOwner(userId);
    }

    // Local Businesses Collection
    match /businesses/{businessId} {
      // Anyone can discover local Goan businesses and marketplace listings
      allow read: if true;
      
      // Only authenticated users can register their business
      allow create: if isAuthenticated() 
                    && request.resource.data.ownerUid == request.auth.uid;
      
      // Only the listing owner can update or delete their business listing
      allow update, delete: if isAuthenticated() 
                            && resource.data.ownerUid == request.auth.uid;
    }

    // Telemetry and Nudges Collection (Phase 3 & Phase 4 Authority telemetry)
    match /nudges/{nudgeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
