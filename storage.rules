rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ==========================================
    // 1. BUSINESS OWNER MARKETPLACE PHOTOS
    // ==========================================
    // Stored hierarchically: business-images/{ownerUid}/{listingId}/{fileName}
    match /business-images/{ownerUid}/{listingId}/{fileName} {
      
      // Anyone (tourists, public visitors) can view business photos
      allow read: if true;
      
      // Only the authenticated business owner who matches the ownerUid can upload, update or delete:
      // - Must be authenticated
      // - Must own this specific folder (request.auth.uid == ownerUid)
      // - Must be an image format (JPEG, PNG, WEBP)
      // - Must not exceed 5 MB (5 * 1024 * 1024 bytes)
      allow write: if request.auth != null 
                   && request.auth.uid == ownerUid
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      
      // Deletion: owner or authority
      allow delete: if request.auth != null 
                    && (request.auth.uid == ownerUid || request.auth.token.role == 'authority');
    }
  }
}
