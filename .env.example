# GoaSmart Environment Variables
# Copy this file to .env and configure the values

# Frontend App Port
VITE_PORT=3000

# Google Gemini API Key (For Phase 2 AI Travel Companion)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Open-Meteo Weather API (Optional custom endpoint)
VITE_WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast

# OpenRouteService / OSRM API (For Phase 2 Routing)
VITE_ORS_API_KEY=your_openrouteservice_key_here
